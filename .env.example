# 国内用户取消注释下面一行，加速 GitHub 下载（仅本地 build 时）
# GITHUB_PROXY=https://ghproxy.com/

# ── 多实例 ──────────────────────────────────────────
# 实例数量（1-32）。为 1 时行为与旧版兼容；>1 时启用 netns 隔离
INSTANCE_COUNT=1

# 实例直连起始端口，第 i 个实例端口 = BASE_PORT + i
BASE_PORT=1111

# 负载均衡统一入口端口
LB_PORT=1110

# 负载均衡策略: round（逐请求轮询）| random（随机）| hash（按客户端 IP 的 Rendezvous 哈希）| rotate（定时统一切换）
# rotate：每个时间窗口内所有新连接固定走同一健康实例，到期后统一切到下一个实例；已有长连接不会被中断。
# 除 rotate 外，只要 SOCKS5/HTTP 提供了用户名（id），都会通过 Rendezvous 哈希粘性到固定后端；实例增减时仅迁移必要会话。
LB_STRATEGY=round

# rotate 策略的轮换间隔，默认 5 分钟。支持 5m / 300s / 1h；裸数字按分钟，例如 5 即 5 分钟。
LB_ROTATE_INTERVAL=5m

# 是否启用 LB: auto（实例数>1 时自动开）| 1 | 0
LB_ENABLED=auto

# 映射到宿主机的端口范围（需覆盖 LB_PORT 与所有实例端口）
# 默认 1110-1142 可覆盖 LB + 最多 32 实例（BASE_PORT=1111）
PORT_RANGE_START=1110
PORT_RANGE_END=1142

# ── IP 版本优先（可选）────────────────────────────
# 开启后 GOST 对双栈域名选用 A（IPv4）或 AAAA（IPv6）。
# 双栈目标的首选地址建连失败时，不会自动改用另一地址族。
# 两项最多开启一项；若同时开启，PREFER_IPV4 优先。
# PREFER_IPV4=1
# PREFER_IPV6=1

# ── 健康检测与 Free 回退（秒）──────────────────────
# HEALTH_CHECK_INTERVAL=60
# HEALTH_SOFT_FAILURES=3
# HEALTH_FALLBACK_AFTER=600
# 每轮健康检测输出完整状态表到 docker logs；本轮变化实例标记 🔄。设为 0 仅保留 health-check.log
# STATUS_EVENT_LOG=1

# ── 定时滚动硬重启 ────────────────────────────────
# auto：INSTANCE_COUNT>=4 才启用；1/0 强制开/关
# 整轮间隔从「上一轮开始」起算；到点上一轮还在跑则忽略本轮
# ROTATE_RESTART_ENABLED=auto
# ROTATE_RESTART_INTERVAL=6h
# ROTATE_RESTART_PROBE_TIMEOUT=90
# ROTATE_RESTART_RETRIES=2
# 先从 LB 摘流，再等待该实例的连接自然结束；超时后继续重启。设为 0 可关闭等待。
# ROTATE_RESTART_DRAIN_TIMEOUT=120

# ── GOST / LB 内存相关（可选）──────────────────────
# 默认已偏内存友好；高并发可适当加大 buffer / idle
# GOST_IDLE_TIMEOUT=120s
# GOST_READ_BUFFER=32768
# GOST_WRITE_BUFFER=32768
# GOST_BACKLOG=1024
# LB_IDLE_TIMEOUT=120

# ── 上游 SOCKS5 TUN（可选）────────────────────────
# WARP 注册/MASQUE 建连经 SOCKS5 节点；最终业务出口仍是 Cloudflare WARP IP
# 节点必须支持 SOCKS5 UDP Associate（UPSTREAM_SOCKS5_UDP=udp）
# UPSTREAM_SOCKS5=socks5://user:pass@192.168.1.2:1086
# UPSTREAM_SOCKS5=192.168.1.2:1086
# UPSTREAM_SOCKS5_UDP=udp
# UPSTREAM_MTU=1280

# 时区
# TZ=Asia/Shanghai
