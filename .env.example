# 国内用户取消注释下面一行，加速 GitHub 下载
# 可选代理：
#   https://ghproxy.com/
#   https://mirror.ghproxy.com/
#   https://gh-proxy.com/
# GITHUB_PROXY=https://ghproxy.com/

# 健康检测与 Free 回退（秒）
# HEALTH_CHECK_INTERVAL=60
# HEALTH_SOFT_FAILURES=3
# HEALTH_FALLBACK_AFTER=600

# 内存回收阈值（KB，196608 = 192MB）：守护进程 RSS 超过该值会被自动重启回收
# WARP_SVC_RSS_MAX_KB=196608
# GOST_RSS_MAX_KB=196608

# 容器内存硬上限，兜底防止泄漏拖垮宿主机
# MEM_LIMIT=512m

# 日志轮转检查间隔（秒）
# LOG_CHECK_INTERVAL=60
